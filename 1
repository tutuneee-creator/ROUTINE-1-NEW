let currentQ = 0;
let score = 0;
let timer;
let timeLeft = 30;

function startQuiz() {
    document.getElementById('start-screen').classList.add('hide');
    document.getElementById('quiz-screen').classList.remove('hide');
    loadQuestion();
}

function loadQuestion() {
    clearInterval(timer);
    timeLeft = 30;
    document.getElementById('timer').innerText = timeLeft;
    
    timer = setInterval(() => {
        timeLeft--;
        document.getElementById('timer').innerText = timeLeft;
        if (timeLeft <= 0) {
            clearInterval(timer);
            autoSelectAnswer();
        }
    }, 1000);

    const qData = quizData[currentQ];
    document.getElementById('question-count').innerText = `Question ${currentQ + 1}/${quizData.length}`;
    document.getElementById('question').innerText = qData.q;
    
    const optionsGrid = document.getElementById('options');
    optionsGrid.innerHTML = '';
    
    qData.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerText = opt;
        btn.onclick = () => selectAnswer(idx);
        optionsGrid.appendChild(btn);
    });
    
    document.getElementById('next-btn').classList.add('hide');
}

function selectAnswer(selectedIdx) {
    clearInterval(timer);
    const qData = quizData[currentQ];
    const buttons = document.querySelectorAll('.option-btn');
    
    buttons.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === qData.ans) {
            btn.classList.add('correct');
        }
        if (idx === selectedIdx && selectedIdx !== qData.ans) {
            btn.classList.add('wrong');
        }
    });

    if (selectedIdx === qData.ans) {
        score += 10;
        document.getElementById('score').innerText = `Score: ${score}`;
    }

    document.getElementById('next-btn').classList.remove('hide');
}

function autoSelectAnswer() {
    selectAnswer(-1);
}

function nextQuestion() {
    currentQ++;
    if (currentQ < quizData.length) {
        loadQuestion();
    } else {
        showResults();
    }
}

function showResults() {
    document.getElementById('quiz-screen').classList.add('hide');
    document.getElementById('result-screen').classList.remove('hide');
    document.getElementById('final-score').innerText = `Your Final Score: ${score} / ${quizData.length * 10}`;
}
</script>
