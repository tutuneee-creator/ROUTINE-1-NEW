<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YT-DREAMDOSE Ultimate MCQ Challenge</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent-color: #f59e0b;
            --correct-color: #10b981;
            --wrong-color: #ef4444;
            --text-color: #f8fafc;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .quiz-container {
            background-color: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 800px;
            padding: 30px;
            position: relative;
            overflow: hidden;
            border: 2px solid #334155;
        }

        .watermark {
            text-align: center;
            font-size: 1.6rem;
            font-weight: 900;
            color: var(--accent-color);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 10px;
            background: rgba(245, 158, 11, 0.1);
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px dashed var(--accent-color);
        }

        .header-status {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-size: 1.1rem;
            font-weight: bold;
        }

        .timer-box {
            background: #334155;
            padding: 8px 16px;
            border-radius: 20px;
            color: #ef4444;
        }

        .question-box {
            font-size: 1.15rem;
            line-height: 1.6;
            margin-bottom: 25px;
            white-space: pre-line;
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .option-btn {
            background-color: #334155;
            color: var(--text-color);
            border: 2px solid transparent;
            padding: 14px 20px;
            border-radius: 10px;
            font-size: 1rem;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .option-btn:hover {
            background-color: #475569;
            border-color: var(--accent-color);
        }

        .option-btn.correct {
            background-color: var(--correct-color) !important;
            color: white;
            font-weight: bold;
        }

        .option-btn.wrong {
            background-color: var(--wrong-color) !important;
            color: white;
            font-weight: bold;
        }

        .controls {
            margin-top: 25px;
            display: flex;
            justify-content: flex-end;
        }

        .next-btn, .start-btn {
            background-color: var(--accent-color);
            color: #000;
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.1s ease;
        }

        .next-btn:active, .start-btn:active {
            transform: scale(0.95);
        }

        .result-screen, .start-screen {
            text-align: center;
            padding: 20px 0;
        }

        .hide {
            display: none;
        }
    </style>
</head>
<body>

<div class="quiz-container">
    <div class="watermark">YT-DREAMDOSE</div>

    <div id="start-screen" class="start-screen">
        <h2>Bilingual Game-Show Quiz</h2>
        <p>Total Questions: 30</p>
        <p>Timer per question: 30 Seconds</p>
        <button class="start-btn" onclick="startQuiz()">Start Quiz Now</button>
    </div>

    <div id="quiz-screen" class="hide">
        <div class="header-status">
            <span id="question-count">Question 1/30</span>
            <span id="score">Score: 0</span>
            <span class="timer-box">⏳ <span id="timer">30</span>s</span>
        </div>

        <div id="question" class="question-box"></div>
        <div id="options" class="options-grid"></div>

        <div class="controls">
            <button id="next-btn" class="next-btn hide" onclick="nextQuestion()">Next Question</button>
        </div>
    </div>

    <div id="result-screen" class="result-screen hide">
        <h2>Game Over!</h2>
        <h3 id="final-score"></h3>
        <button class="start-btn" onclick="location.reload()">Try Again</button>
    </div>
</div>

